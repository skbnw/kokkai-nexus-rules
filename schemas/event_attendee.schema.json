{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kokkai-nexus-rules/schemas/event_attendee.schema.json",
  "title": "EventAttendee",
  "description": "event_attendees テーブルの基本形。COMMON_RULES.md §5-8・cursor_session_summary.md を統合。",
  "type": "object",
  "required": ["event_id", "person_id", "evidence", "confidence", "recorded_by"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^EV-[0-9]{8}-[0-9]{4}$" },
    "person_id": { "type": "string", "pattern": "^P[0-9]{6}$", "description": "COMMON_RULES §2-1参照。talentsテーブル等の独自IDではなく、必ずこの統一IDを使う（§5-9-a）" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.enum.json" },
      "minItems": 1,
      "description": "複数種類重なるほど confidence が上がる"
    },
    "confidence": {
      "type": "string",
      "enum": ["confirmed", "probable", "pending", "unidentified"]
    },
    "speaker_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unable"],
      "description": "YouTube（§5-7-e）・TV放送（§5-9-c）で話者分離が未完了の場合に使用"
    },
    "bbox": {
      "type": ["array", "null"],
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "写真上の正規化座標（0.0〜1.0）"
    },
    "is_photo_absent": { "type": "boolean", "default": false },
    "recorded_by": { "type": "string", "description": "auth.users(id)。Layer4の取材者記名をDB層で担保する（§1-P5）" }
  },
  "additionalProperties": true
}
